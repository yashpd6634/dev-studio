{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@app/studio/*": ["apps/studio/*"],
      "@repo/*": ["packages/*"],
      "@ui/*": ["packages/ui/src/*"],
      "@repo/ui/*": ["packages/ui/src/*"]
    },
    "plugins": [
      {
        "name": "next",
      },
    ],
    "types": ["@uploadcare/file-uploader/types/jsx"]
  },
  "include": [
  "next-env.d.ts",
  "**/*.js",
  "**/*.ts",
  "**/*.tsx",
  ".next/types/**/*.ts",
  "../../packages/ui/src/**/*.ts",
  "../../packages/ui/src/**/*.tsx"
],
  "exclude": ["node_modules"],
}
